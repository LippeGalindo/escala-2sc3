<script>
/* ======================= CONSTANTS ======================= */
const LOGO_B64 = "data:image/jpeg;base64,";
const OPERATORS = ["MAQ","MON","MAI","IVN","OTO","DAN","BAZ","ITA","GLO","REG"];
