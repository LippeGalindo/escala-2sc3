 {day:13, sitfaa:null, t12:"IVN", t24:"DAN"},
 {day:14, sitfaa:null, t12:"GLO", t24:"REG"},
 {day:15, sitfaa:null, t12:null,  t24:"MAQ"},
 {day:16, sitfaa:null, t12:null,  t24:"ITA"},
 {day:17, sitfaa:null, t12:"OTO", t24:"MAI"},
 {day:18, sitfaa:null, t12:"IVN", t24:"GLO"},
 {day:19, sitfaa:null, t12:"DAN", t24:"REG"},
 {day:20, sitfaa:null, t12:"MAQ", t24:"BAZ"},
 {day:21, sitfaa:null, t12:"ITA", t24:"GLO"},
 {day:22, sitfaa:null, t12:null,  t24:"MON"},
 {day:23, sitfaa:null, t12:null,  t24:"BAZ"},
 {day:24, sitfaa:null, t12:"REG", t24:"IVN"},
 {day:25, sitfaa:null, t12:"ITA", t24:"BAZ"},
 {day:26, sitfaa:null, t12:"GLO", t24:"MAQ"},
 {day:27, sitfaa:null, t12:"MON", t24:"OTO"},
 {day:28, sitfaa:null, t12:"MAI", t24:"ITA"},
 {day:29, sitfaa:null, t12:null,  t24:"MAI"},
 {day:30, sitfaa:null, t12:null,  t24:"DAN"},
 {day:31, sitfaa:null, t12:"OTO", t24:"MON"},
];

const HOURS = {sitfaa:8, t12:12, t24:24};
const SHIFT_LABEL = {sitfaa:"SITFAA 8H", t12:"12H (08–20)", t24:"24H (14–14)"};

/* ======================= STATE ======================= */
let state = {
  screen: "loading",
  operator: null,
  tab: "escala",
  months: [],
  viewMonth: null,
  scheduleCache: {},
  swapsCache: {},
  originalCache: {},
  sheetsWebhook: null,
  adminUnlocked: false,
  escalanteMonth: null,
  escalanteDraft: null,
  swapFilter: "todas",
  histMonth: null,
  reqMode: "troca",
};

/* ======================= DATE HELPERS ======================= */
function monthLabel(monthKey){ const [y,m]=monthKey.split("-"); return MONTH_NAMES[parseInt(m,10)-1] + " " + y; }
function daysInMonth(monthKey){ const [y,m]=monthKey.split("-").map(Number); return new Date(y, m, 0).getDate(); }
function weekdayIdx(monthKey, day){ const [y,m]=monthKey.split("-").map(Number); return new Date(y, m-1, day).getDay(); }
function weekdayOf(monthKey, day){ return WEEKDAYS[weekdayIdx(monthKey, day)]; }
function isRedDay(monthKey, day){ const wd = weekdayIdx(monthKey, day); return wd===0 || wd===6 || wd===3; }
function nextMonthKey(monthKey){ let [y,m]=monthKey.split("-").map(Number); m+=1; if(m>12){m=1;y+=1;} return y+"-"+String(m).padStart(2,"0"); }
function blankSchedule(monthKey){ const n=daysInMonth(monthKey); const arr=[]; for(let d=1; d<=n; d++) arr.push({day:d, sitfaa:null, t12:null, t24:null}); return arr; }

// ---- Integração Google Sheets (formato: DIA,SITFAA,12H,24H) ----
function normCell(v){
  if(v===undefined || v===null) return null;
  const t = String(v).trim().toUpperCase();
  return (t==="" || t==="-" || t==="—" || t==="---") ? null : t;
}
function parseScheduleCsv(text, monthKey){
  const lines = text.split(/\r?\n/).map(l=>l.trim()).filter(l=>l.length>0);
  if(lines.length===0) throw new Error("planilha vazia");
  const startIdx = /dia/i.test(lines[0]) ? 1 : 0; // pula cabeçalho se existir
  const byDay = {};
  for(let i=startIdx; i<lines.length; i++){
    const cols = lines[i].split(",").map(c=>c.trim());
    const day = parseInt(cols[0], 10);
    if(!day) continue;
    byDay[day] = { day, sitfaa: normCell(cols[1]), t12: normCell(cols[2]), t24: normCell(cols[3]) };
  }
  const n = daysInMonth(monthKey);
  const out = [];
  for(let d=1; d<=n; d++){
    out.push(byDay[d] || {day:d, sitfaa:null, t12:null, t24:null});
  }
  return out;
}
function buildScheduleCsv(sch){
  const lines = ["DIA,SITFAA,12H,24H"];
  sch.forEach(d=>lines.push(`${d.day},${d.sitfaa||""},${d.t12||""},${d.t24||""}`));
  return lines.join("\n");
}

/* ======================= STORAGE HELPERS (Supabase) ======================= */
async function kvGet(key){
  const url = `${SUPABASE_URL}/rest/v1/app_kv?key=eq.${encodeURIComponent(key)}&select=value`;
  const res = await fetch(url, { headers: SB_HEADERS });
  if(!res.ok) throw new Error("Supabase GET falhou: " + res.status);
  const rows = await res.json();
  if(!rows.length) throw new Error("chave não encontrada: " + key);
  return rows[0].value;
}
async function kvSet(key, value){
  const url = `${SUPABASE_URL}/rest/v1/app_kv`;
  const res = await fetch(url, {
    method: "POST",
    headers: { ...SB_HEADERS, "Prefer": "resolution=merge-duplicates,return=minimal" },
    body: JSON.stringify([{ key, value, updated_at: new Date().toISOString() }])
  });
  if(!res.ok) throw new Error("Supabase SET falhou: " + res.status);
}

async function loadMonthsList(){
  try{
    return await kvGet(MONTHS_LIST_KEY);
  }catch(e){
    const seed = [SEED_MONTH];
    try{ await kvSet(MONTHS_LIST_KEY, seed); }catch(e2){}
    return seed;
  }
}
async function saveMonthsList(list){
  state.months = list;
  try{ await kvSet(MONTHS_LIST_KEY, list); }catch(e){ console.error("erro ao salvar lista de meses", e); }
}
async function loadSchedule(monthKey){
  try{
    return await kvGet("schedule:"+monthKey);
  }catch(e){
    const seed = monthKey === SEED_MONTH ? JSON.parse(JSON.stringify(SEED_SCHEDULE)) : blankSchedule(monthKey);
    try{ await kvSet("schedule:"+monthKey, seed); }catch(e2){}
    return seed;
  }
}
async function saveSchedule(monthKey, sch){
  state.scheduleCache[monthKey] = sch;
  try{ await kvSet("schedule:"+monthKey, sch); }catch(e){ console.error("erro ao salvar escala", e); }
}
async function loadSwaps(monthKey){
  try{
    return await kvGet("swaps:"+monthKey);
  }catch(e){
    try{ await kvSet("swaps:"+monthKey, []); }catch(e2){}
    return [];
  }
}
async function saveSwaps(monthKey, list){
  state.swapsCache[monthKey] = list;
  try{ await kvSet("swaps:"+monthKey, list); }catch(e){ console.error("erro ao salvar trocas", e); }
}
async function loadOriginalSchedule(monthKey){
  try{
    return await kvGet("schedule_orig:"+monthKey);
  }catch(e){
    // fallback para meses criados antes desse recurso: usa a escala atual como linha de base
    const cur = state.scheduleCache[monthKey] || await loadSchedule(monthKey);
    const clone = JSON.parse(JSON.stringify(cur));
    try{ await kvSet("schedule_orig:"+monthKey, clone); }catch(e2){}
    return clone;
  }
}
async function saveOriginalSchedule(monthKey, sch){
  state.originalCache[monthKey] = sch;
  try{ await kvSet("schedule_orig:"+monthKey, sch); }catch(e){ console.error("erro ao salvar escala original", e); }
}
async function ensureMonthLoaded(monthKey){
  if(!state.scheduleCache[monthKey]) state.scheduleCache[monthKey] = await loadSchedule(monthKey);
  if(!state.swapsCache[monthKey]) state.swapsCache[monthKey] = await loadSwaps(monthKey);
  if(!state.originalCache[monthKey]) state.originalCache[monthKey] = await loadOriginalSchedule(monthKey);
}
function curSchedule(){ return state.scheduleCache[state.viewMonth]; }
function curSwaps(){ return state.swapsCache[state.viewMonth]; }

/* ======================= UTIL ======================= */
function showToast(msg){
  const t = document.getElementById("toast");
  t.textContent = msg; t.classList.add("show");
  clearTimeout(showToast._t);
  showToast._t = setTimeout(()=>t.classList.remove("show"), 2200);
}
function myDuties(op){
  const out = [];
  for(const d of curSchedule()){
    for(const type of ["t24","t12","sitfaa"]){
      if(d[type] === op) out.push({day:d.day, type});
    }
  }
  return out;
}
// true se `op` já tem QUALQUER serviço lançado no dia `day` daquele mês (em qualquer um dos 3 turnos)
function operatorBusyOnDay(sch, day, op){
  const row = sch.find(d=>d.day===day);
  if(!row || !op) return false;
  return ["t24","t12","sitfaa"].some(t=>row[t]===op);
}
function computeHoursFor(sch){
  const totals = {}; OPERATORS.forEach(o=>totals[o]={t24:0,t12:0,sitfaa:0,total:0,svc:0});
  for(const d of sch){
    for(const type of ["t24","t12","sitfaa"]){
      const op = d[type];
      if(op && totals[op]){
        totals[op][type]++;
        totals[op].total += HOURS[type];
        totals[op].svc++;
      }
    }
  }
  return totals;
}
function computeHours(){ return computeHoursFor(curSchedule()); }
// marcador textual (para <option>, que não aceita cor) e em HTML colorido (para texto normal)
function redSuffix(day){ return isRedDay(state.viewMonth, day) ? " 🔴" : ""; }
function dayColored(day){
  const p = String(day).padStart(2,'0');
  return isRedDay(state.viewMonth, day) ? `<span style="color:var(--red);font-weight:700;">${p}</span>` : p;
}
function escapeHtml(str){
  const d = document.createElement("div"); d.textContent = str; return d.innerHTML;
}

