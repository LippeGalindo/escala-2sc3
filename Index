const WEEKDAYS = ["DOM","SEG","TER","QUA","QUI","SEX","SAB"];
const MONTH_NAMES = ["JANEIRO","FEVEREIRO","MARÇO","ABRIL","MAIO","JUNHO","JULHO","AGOSTO","SETEMBRO","OUTUBRO","NOVEMBRO","DEZEMBRO"];
const MONTHS_LIST_KEY = "months:list";
const ADMIN_CODE = "sobrevoo2026";

// ---- Supabase (banco real, substitui o armazenamento interno do Claude) ----
const SUPABASE_URL = "https://jvmwueqtwqehcghfgkbo.supabase.co";
const SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp2bXd1ZXF0d3FlaGNnaGZna2JvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUyNjkyNzgsImV4cCI6MjEwMDg0NTI3OH0.xi5RZ_Dh_DerUBXsipW283YdxvvQrL6GZn6Xnj23GWM";
const SB_HEADERS = {
  "apikey": SUPABASE_KEY,
  "Authorization": "Bearer " + SUPABASE_KEY,
  "Content-Type": "application/json"
};

// Extraído da planilha 08-ESCALA-AGOSTO-2026-_AD.xlsx (aba AGOSTO-2026)
const SEED_SCHEDULE = [
 {day:1,  sitfaa:null, t12:null,  t24:"IVN"},
 {day:2,  sitfaa:null, t12:null,  t24:"GLO"},
 {day:3,  sitfaa:null, t12:"BAZ", t24:"OTO"},
 {day:4,  sitfaa:null, t12:"BAZ", t24:"DAN"},
