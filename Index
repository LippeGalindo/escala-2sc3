 {day:7,  sitfaa:null, t12:"REG", t24:"DAN"},
 {day:8,  sitfaa:null, t12:null,  t24:"OTO"},
 {day:9,  sitfaa:null, t12:null,  t24:"REG"},
 {day:10, sitfaa:null, t12:"DAN", t24:"ITA"},
 {day:11, sitfaa:null, t12:"GLO", t24:"MON"},
