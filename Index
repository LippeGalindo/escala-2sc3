/* ======================= RENDER: ESCALA ======================= */
function renderEscala(el){
  const sch = curSchedule();
  const totalDays = daysInMonth(state.viewMonth);
  const rows = sch.map((d, idx)=>{
    const mine = [d.t24,d.t12,d.sitfaa].includes(state.operator);
    const red = isRedDay(state.viewMonth, d.day);
    const chip = (val, label) => {
      if(!val) return `<span class="shift-chip empty">${label} —</span>`;
      const isMe = val === state.operator;
      return `<span class="shift-chip ${isMe?'me':''}">${label} <b>${val}</b></span>`;
    };
    const nextDayLabel = d.day === totalDays ? "01 (mês seg.)" : String(d.day+1).padStart(2,'0');
    // quem sai às 14h hoje é o operador que entrou no turno 24h do dia anterior
    const prevDay = idx > 0 ? sch[idx-1] : null;
    const outOp = prevDay ? prevDay.t24 : null;
    const inOp = d.t24;
    const isMeOut = outOp === state.operator;
    const isMeIn = inOp === state.operator;
    const t24Block = `<div class="t24-block ${(isMeOut||isMeIn)?'me':''} ${(!outOp && !inOp)?'empty':''}">
        <div class="t24-flow">
          <span class="t24-tag">24H</span>
          <span class="t24-op ${isMeOut?'me':''} ${!outOp?'dash':''}">${outOp || '—'}</span>
          <span class="t24-label"><b>sai 14h</b><span class="t24-tiny">hoje</span></span>
          <span class="t24-arrow">→</span>
          <span class="t24-label"><b>entra 14h</b><span class="t24-tiny">hoje</span></span>
          <span class="t24-op ${isMeIn?'me':''} ${!inOp?'dash':''}">${inOp || '—'}</span>
        </div>
        <div class="t24-sub">${inOp ? `<b>${inOp}</b> fica de serviço 24h: entra hoje às 14h e sai amanhã (dia ${nextDayLabel}) às 14h` : 'sem operador 24h neste dia'}</div>
      </div>`;
    return `<div class="day-row ${mine?'mine':''} ${red?'red-day':''}">
      <div class="day-col-date">
        <div class="day-num mono">${String(d.day).padStart(2,'0')}</div>
        <div class="day-wk mono ${red?'red':''}">${weekdayOf(state.viewMonth, d.day)}</div>
      </div>
      <div class="day-shifts-col">
        ${t24Block}
        <div class="day-shifts">
          ${chip(d.t12,"12H")}
          ${chip(d.sitfaa,"SITFAA")}
        </div>
      </div>
    </div>`;
  }).join("");

  el.innerHTML = `
    <div class="month-select-wrap">
      <label>Mês</label>
      <select id="monthSel">
        ${state.months.map(m=>`<option value="${m}" ${m===state.viewMonth?'selected':''}>${monthLabel(m)}</option>`).join("")}
      </select>
    </div>
    <div class="banner">Turno 24H: o bloco mostra quem <b>sai às 14h</b> (à esquerda) e quem <b>entra às 14h</b> (à direita) naquele dia — o operador que entra fica de serviço até 14h do dia seguinte. Turno 12H: entra 8h, sai 20h (dias úteis). SITFAA: expediente 8h, atualmente desativado. Suas escalas ficam destacadas em âmbar. Sábados, domingos e quartas-feiras são <b style="color:var(--red)">escala vermelha</b> (barra vermelha à esquerda).</div>
    <div class="section-title">Dias do mês</div>
    ${rows}
  `;
  document.getElementById("monthSel").addEventListener("change", async (e)=>{
    const m = e.target.value;
    state.viewMonth = m;
    await ensureMonthLoaded(m);
    render();
  });
}

/* ======================= RENDER: HORAS ======================= */
function renderHoras(el){
  const curTotals = computeHoursFor(curSchedule());
  const origSch = state.originalCache[state.viewMonth] || curSchedule();
  const origTotals = computeHoursFor(origSch);
  const meCur = curTotals[state.operator];
  const meOrig = origTotals[state.operator];
  const changed = meCur.total !== meOrig.total;
  const ranking = OPERATORS.slice().sort((a,b)=>curTotals[b].total-curTotals[a].total);

  el.innerHTML = `
    <div class="month-hint mono">${monthLabel(state.viewMonth)}</div>
    <div class="hours-hero">
      <div class="hours-dual">
        <div class="hours-col">
          <div class="hours-big mono" style="font-size:30px;">${meOrig.total}h</div>
          <div class="hours-label">escala original</div>
        </div>
        <div class="hours-arrow">→</div>
        <div class="hours-col">
          <div class="hours-big mono" style="color:${changed?'var(--green)':'var(--amber)'}">${meCur.total}h</div>
          <div class="hours-label">atual (com trocas)</div>
        </div>
      </div>
      <div class="hours-label" style="margin-top:8px;">${meCur.svc} serviço${meCur.svc===1?'':'s'} na escala atual</div>
    </div>
    <div class="breakdown">
      <div class="bd-card"><div class="bd-num mono">${meCur.t24}</div><div class="bd-label">turnos 24H</div></div>
      <div class="bd-card"><div class="bd-num mono">${meCur.t12}</div><div class="bd-label">turnos 12H</div></div>
      <div class="bd-card"><div class="bd-num mono">${meCur.sitfaa}</div><div class="bd-label">SITFAA</div></div>
    </div>
    <div class="section-title">Comparativo entre operadores (original → atual)</div>
    ${ranking.map(o=>`
      <div class="rank-row ${o===state.operator?'me':''}">
        <span>${o}</span>
        <span class="h">${origTotals[o].total}h → <b style="color:${origTotals[o].total!==curTotals[o].total?'var(--green)':'var(--text)'}">${curTotals[o].total}h</b></span>
      </div>
    `).join("")}
  `;
}

/* ======================= RENDER: TROCAS ======================= */
function renderTrocas(el){
  const my = myDuties(state.operator);
  const swaps = curSwaps();
  const incoming = swaps.filter(s=>s.toOp===state.operator && s.status==="pendente");
  const outgoing = swaps.filter(s=>s.fromOp===state.operator);
  const history = swaps.filter(s=>s.status!=="pendente" && (s.fromOp===state.operator || s.toOp===state.operator));
  const filter = state.swapFilter || "todas";
  const all = swaps.slice().sort((a,b)=>b.createdAt-a.createdAt)
    .filter(s => filter==="todas" ? true : s.status===filter);
  const reqMode = state.reqMode || "troca";

  function reqRow(s, mode){
    const pillMap = {pendente:["status-pending","PENDENTE"], aceito:["status-accepted","ACEITO"], recusado:["status-declined","RECUSADO"], cancelado:["status-cancelled","CANCELADO"]};
    const [pill, pillText] = pillMap[s.status] || ["status-declined", s.status.toUpperCase()];
    const isAssuncao = (s.mode||"troca") === "assuncao";
    const mainLine = isAssuncao
      ? `${s.fromOp} assume de ${s.toOp} — dia ${dayColored(s.fromDay)} (${SHIFT_LABEL[s.type]})`
      : `${s.fromOp} dia ${dayColored(s.fromDay)} (${SHIFT_LABEL[s.type]}) ⇄ ${s.toOp} dia ${dayColored(s.toDay)}`;
    let actions = "";
    if(mode === "respond"){
      actions = `<div class="req-actions">
        <button class="btn" data-accept="${s.id}">Aceitar</button>
        <button class="btn decline" data-decline="${s.id}">Recusar</button>
      </div>`;
    } else if(mode === "cancel"){
      actions = `<div class="req-actions">
        <button class="btn decline" data-cancel="${s.id}">Cancelar pedido</button>
      </div>`;
    }
    return `<div class="req-row" data-id="${s.id}">
      <div class="req-top">
        <span>${isAssuncao?'<span class="mode-tag">ASSUNÇÃO</span> ':''}${mainLine}</span>
        <span class="status-pill ${pill}">${pillText}</span>
      </div>
      ${s.note? `<div class="req-note">"${escapeHtml(s.note)}"</div>` : ""}
      ${actions}
    </div>`;
  }

  el.innerHTML = `
    <div class="month-hint mono">${monthLabel(state.viewMonth)}</div>
    <div class="banner">Uma troca só é efetivada depois que o colega aceita o pedido pelo app. Trocas acontecem sempre entre turnos do mesmo tipo (24H↔24H, 12H↔12H, SITFAA↔SITFAA), e não é possível trocar para um dia em que o operador já tenha outro serviço lançado. Dias marcados com 🔴 são escala vermelha (sábado, domingo ou quarta-feira).</div>

    <div class="card">
      <h3>Solicitar</h3>
      <label for="reqModeSel">Tipo de pedido</label>
      <select id="reqModeSel">
        <option value="troca" ${reqMode==='troca'?'selected':''}>Troca (imediata, mesmo tipo de turno)</option>
        <option value="assuncao" ${reqMode==='assuncao'?'selected':''}>Assumir serviço (colega paga depois)</option>
      </select>

      <div id="modeTroca" style="display:${reqMode==='troca'?'block':'none'}">
        ${my.length===0? `<div class="empty-state">Você não tem serviços neste mês.</div>` : `
        <label for="mySel">Seu serviço</label>
        <select id="mySel">
          ${my.map(d=>`<option value="${d.day}|${d.type}">Dia ${String(d.day).padStart(2,'0')} — ${SHIFT_LABEL[d.type]}${redSuffix(d.day)}</option>`).join("")}
        </select>

        <label for="colSel">Trocar com</label>
        <select id="colSel">
          ${OPERATORS.filter(o=>o!==state.operator).map(o=>`<option value="${o}">${o}</option>`).join("")}
        </select>

        <label for="theirSel">Serviço do colega</label>
        <select id="theirSel"><option>—</option></select>
        <div class="field-warning" id="trocaWarning" style="display:none"></div>

        <label for="noteInput">Mensagem (opcional)</label>
        <input id="noteInput" type="text" placeholder="ex: preciso trocar por compromisso pessoal">

        <button class="btn" id="submitSwap" disabled>Enviar pedido de troca</button>
        `}
      </div>

      <div id="modeAssuncao" style="display:${reqMode==='assuncao'?'block':'none'}">
        <label for="assTypeSel">Tipo de turno a assumir</label>
        <select id="assTypeSel">
          <option value="t24">${SHIFT_LABEL.t24}</option>
          <option value="t12">${SHIFT_LABEL.t12}</option>
          <option value="sitfaa">${SHIFT_LABEL.sitfaa}</option>
        </select>

        <label for="assColSel">De qual colega</label>
        <select id="assColSel">
          ${OPERATORS.filter(o=>o!==state.operator).map(o=>`<option value="${o}">${o}</option>`).join("")}
        </select>

        <label for="assDaySel">Dia do colega a assumir</label>
        <select id="assDaySel"><option>—</option></select>
        <div class="field-warning" id="assWarning" style="display:none"></div>

        <label for="assNoteInput">Observação (obrigatório) — explique como/quando será pago</label>
        <input id="assNoteInput" type="text" placeholder="ex: MAQ pega serviço meu depois, ainda sem data definida">

        <button class="btn" id="submitAssuncao" disabled>Enviar pedido de assunção</button>
      </div>
    </div>

    <div class="section-title">Pedidos recebidos</div>
    ${incoming.length===0? `<div class="empty-state">Nenhum pedido pendente para você.</div>` :
      incoming.map(s=>reqRow(s, "respond")).join("")}

    <div class="section-title">Meus pedidos enviados</div>
    ${outgoing.filter(s=>s.status==="pendente").length===0? `<div class="empty-state">Você não tem pedidos pendentes.</div>` :
      outgoing.filter(s=>s.status==="pendente").map(s=>reqRow(s, "cancel")).join("")}

    <div class="section-title">Meu histórico</div>
    ${history.length===0? `<div class="empty-state">Nenhuma troca sua concluída ainda.</div>` :
      history.map(s=>reqRow(s, "none")).join("")}

    <div class="section-title">Trocas de todos os operadores</div>
    <div class="month-select-wrap">
      <label for="swapFilterSel">Ver</label>
      <select id="swapFilterSel">
        <option value="todas" ${filter==='todas'?'selected':''}>Todas</option>
        <option value="pendente" ${filter==='pendente'?'selected':''}>Pendentes</option>
        <option value="aceito" ${filter==='aceito'?'selected':''}>Aceitas</option>
        <option value="recusado" ${filter==='recusado'?'selected':''}>Recusadas</option>
        <option value="cancelado" ${filter==='cancelado'?'selected':''}>Canceladas</option>
      </select>
    </div>
    ${all.length===0? `<div class="empty-state">Nenhuma troca ${filter==='todas'?'registrada':(filter==='aceito'?'aceita':filter==='recusado'?'recusada':filter==='cancelado'?'cancelada':'pendente')} neste mês.</div>` :
      all.map(s=>reqRow(s, "none")).join("")}
  `;

  document.getElementById("reqModeSel").addEventListener("change", (e)=>{
    state.reqMode = e.target.value;
    renderTrocas(el);
  });

  /* ---- modo troca ---- */
  const mySel = document.getElementById("mySel");
  const colSel = document.getElementById("colSel");
  const theirSel = document.getElementById("theirSel");
  const submitBtn = document.getElementById("submitSwap");
  const trocaWarning = document.getElementById("trocaWarning");

  function refreshTheirOptions(){
    if(!mySel) return;
    const [fromDay, type] = mySel.value.split("|");
    const colleague = colSel.value;
    const theirDuties = curSchedule().filter(d=>d[type]===colleague).map(d=>d.day);
    theirSel.innerHTML = theirDuties.length
      ? theirDuties.map(day=>`<option value="${day}">Dia ${String(day).padStart(2,'0')} — ${SHIFT_LABEL[type]}${redSuffix(day)}</option>`).join("")
      : `<option value="">Sem serviços deste tipo</option>`;
    checkTrocaConflict();
  }
  function checkTrocaConflict(){
    if(!mySel || !theirSel.value){ submitBtn.disabled = true; trocaWarning.style.display="none"; return; }
    const [fromDay, type] = mySel.value.split("|");
    const toDay = parseInt(theirSel.value, 10);
    const toOp = colSel.value;
    const sch = curSchedule();
    const conflictA = operatorBusyOnDay(sch, toDay, state.operator);
    const conflictB = operatorBusyOnDay(sch, parseInt(fromDay,10), toOp);
    if(conflictA || conflictB){
      trocaWarning.style.display = "block";
      trocaWarning.textContent = conflictA
        ? `Você já tem serviço no dia ${String(toDay).padStart(2,'0')} — não é possível assumir esse dia também.`
        : `${toOp} já tem serviço no dia ${fromDay} — não é possível assumir esse dia também.`;
      submitBtn.disabled = true;
    } else {
      trocaWarning.style.display = "none";
      submitBtn.disabled = false;
    }
  }
  if(mySel){
    refreshTheirOptions();
    mySel.addEventListener("change", refreshTheirOptions);
    colSel.addEventListener("change", refreshTheirOptions);
    theirSel.addEventListener("change", checkTrocaConflict);

    submitBtn.addEventListener("click", async ()=>{
      const [fromDay, type] = mySel.value.split("|");
      const toOp = colSel.value;
      const toDay = theirSel.value;
      if(!toDay){ return; }
      const note = document.getElementById("noteInput").value.trim();
      const newSwap = {
        id: "sw_" + Date.now() + "_" + Math.random().toString(36).slice(2,7),
        mode: "troca",
        fromOp: state.operator, toOp,
        fromDay: parseInt(fromDay,10), toDay: parseInt(toDay,10),
        type, note, status:"pendente", createdAt: Date.now()
      };
      const list = curSwaps().slice();
      list.push(newSwap);
      await saveSwaps(state.viewMonth, list);
      showToast("Pedido enviado para " + toOp);
      renderTrocas(el);
    });
  }

  /* ---- modo assunção ---- */
  const assTypeSel = document.getElementById("assTypeSel");
  const assColSel = document.getElementById("assColSel");
  const assDaySel = document.getElementById("assDaySel");
  const assNoteInput = document.getElementById("assNoteInput");
  const submitAssuncao = document.getElementById("submitAssuncao");
  const assWarning = document.getElementById("assWarning");

  function refreshAssDayOptions(){
    const type = assTypeSel.value;
    const colleague = assColSel.value;
    const days = curSchedule().filter(d=>d[type]===colleague).map(d=>d.day);
    assDaySel.innerHTML = days.length
      ? days.map(day=>`<option value="${day}">Dia ${String(day).padStart(2,'0')} — ${SHIFT_LABEL[type]}${redSuffix(day)}</option>`).join("")
      : `<option value="">${colleague} não tem serviços desse tipo</option>`;
    checkAssuncaoConflict();
  }
  function checkAssuncaoConflict(){
    const day = parseInt(assDaySel.value, 10);
    const note = assNoteInput.value.trim();
    if(!day){ submitAssuncao.disabled = true; assWarning.style.display="none"; return; }
    const sch = curSchedule();
    const conflict = operatorBusyOnDay(sch, day, state.operator);
    if(conflict){
      assWarning.style.display = "block";
      assWarning.textContent = `Você já tem serviço no dia ${String(day).padStart(2,'0')} — não é possível assumir esse dia também.`;
      submitAssuncao.disabled = true;
    } else {
      assWarning.style.display = "none";
      submitAssuncao.disabled = note.length === 0;
    }
  }
  if(assTypeSel){
    refreshAssDayOptions();
    assTypeSel.addEventListener("change", refreshAssDayOptions);
    assColSel.addEventListener("change", refreshAssDayOptions);
    assDaySel.addEventListener("change", checkAssuncaoConflict);
    assNoteInput.addEventListener("input", checkAssuncaoConflict);

    submitAssuncao.addEventListener("click", async ()=>{
      const type = assTypeSel.value;
      const holderOp = assColSel.value;
      const day = parseInt(assDaySel.value, 10);
      const note = assNoteInput.value.trim();
      if(!day || !note) return;
      const newSwap = {
        id: "as_" + Date.now() + "_" + Math.random().toString(36).slice(2,7),
        mode: "assuncao",
        fromOp: state.operator, toOp: holderOp,
        fromDay: day, toDay: null,
        type, note, status:"pendente", createdAt: Date.now()
      };
      const list = curSwaps().slice();
      list.push(newSwap);
      await saveSwaps(state.viewMonth, list);
      showToast("Pedido de assunção enviado para " + holderOp);
      renderTrocas(el);
    });
  }

  el.querySelectorAll("[data-accept]").forEach(b=>{
    b.addEventListener("click", async ()=>{ await resolveSwap(b.dataset.accept, "aceito"); });
  });
  el.querySelectorAll("[data-decline]").forEach(b=>{
    b.addEventListener("click", async ()=>{ await resolveSwap(b.dataset.decline, "recusado"); });
  });
  el.querySelectorAll("[data-cancel]").forEach(b=>{
    b.addEventListener("click", async ()=>{ await resolveSwap(b.dataset.cancel, "cancelado"); });
  });
  document.getElementById("swapFilterSel").addEventListener("change", (e)=>{
    state.swapFilter = e.target.value;
    renderTrocas(el);
  });
}

async function resolveSwap(id, decision){
  const list = curSwaps().slice();
  const idx = list.findIndex(s=>s.id===id);
  if(idx === -1) return;
  const s = list[idx];
  if(decision === "aceito"){
    const sch = curSchedule().map(d=>({...d}));
    const isAssuncao = (s.mode||"troca") === "assuncao";
    if(isAssuncao){
      const row = sch.find(d=>d.day===s.fromDay);
      if(!row || row[s.type] !== s.toOp){
        showToast("Não foi possível efetivar: a escala mudou desde o pedido.");
        return;
      }
      if(operatorBusyOnDay(sch, s.fromDay, s.fromOp)){
        showToast(`Não é possível efetivar: ${s.fromOp} já tem serviço no dia ${String(s.fromDay).padStart(2,'0')}.`);
        return;
      }
      row[s.type] = s.fromOp;
      await saveSchedule(state.viewMonth, sch);
    } else {
      const fromRow = sch.find(d=>d.day===s.fromDay);
      const toRow = sch.find(d=>d.day===s.toDay);
      if(!fromRow || !toRow || fromRow[s.type]!==s.fromOp || toRow[s.type]!==s.toOp){
        showToast("Não foi possível efetivar: a escala mudou desde o pedido.");
        return;
      }
      if(operatorBusyOnDay(sch, s.toDay, s.fromOp) || operatorBusyOnDay(sch, s.fromDay, s.toOp)){
        showToast("Não é possível efetivar: conflito de serviço no mesmo dia.");
        return;
      }
      fromRow[s.type] = s.toOp;
      toRow[s.type] = s.fromOp;
      await saveSchedule(state.viewMonth, sch);
    }
  }
  list[idx] = {...s, status:decision, resolvedAt:Date.now()};
  await saveSwaps(state.viewMonth, list);
  showToast(decision === "aceito" ? "Troca efetivada" : (decision === "cancelado" ? "Pedido cancelado" : "Pedido recusado"));
  render();
}

/* ======================= RENDER: HISTÓRICO ======================= */
function renderHistorico(el){
  const m = state.histMonth && state.months.includes(state.histMonth) ? state.histMonth : state.months[state.months.length-1];
  const sch = state.scheduleCache[m] || [];
  const swaps = (state.swapsCache[m] || [])
    .filter(s=>s.status==="aceito")
    .slice()
    .sort((a,b)=>(a.resolvedAt||0)-(b.resolvedAt||0));
  const cancelled = (state.swapsCache[m] || [])
    .filter(s=>s.status==="cancelado")
    .slice()
    .sort((a,b)=>(a.resolvedAt||0)-(b.resolvedAt||0));

  const cancelledRows = cancelled.length===0 ? `<div class="empty-state">Nenhuma troca cancelada neste mês.</div>` :
    cancelled.map(s=>{
      const dt = s.resolvedAt ? new Date(s.resolvedAt).toLocaleDateString('pt-BR') : '';
      const isAssuncao = (s.mode||"troca") === "assuncao";
      const label = isAssuncao
        ? `${s.fromOp} pediu para assumir de ${s.toOp} — dia ${String(s.fromDay).padStart(2,'0')} (${SHIFT_LABEL[s.type]})`
        : `${s.fromOp} dia ${String(s.fromDay).padStart(2,'0')} ⇄ ${s.toOp} dia ${String(s.toDay).padStart(2,'0')} — ${SHIFT_LABEL[s.type]}`;
      return `<div class="req-row swap-jump" data-from="${s.fromDay}" data-to="${s.toDay||''}">
        <div class="req-top">
          <span>${label}</span>
          <span class="status-pill status-cancelled">CANCELADO</span>
        </div>
        ${dt? `<div class="req-note">Cancelada em ${dt}</div>` : ""}
        <div class="jump-hint">toque para ver na escala ↓</div>
      </div>`;
    }).join("");

  const dayRows = sch.map((d, idx)=>{
    const red = isRedDay(m, d.day);
    const prevDay = idx > 0 ? sch[idx-1] : null;
    const outOp = prevDay ? prevDay.t24 : null;
    return `<div class="day-row ${red?'red-day':''}" data-day="${d.day}">
      <div class="day-col-date">
        <div class="day-num mono">${String(d.day).padStart(2,'0')}</div>
        <div class="day-wk mono ${red?'red':''}">${weekdayOf(m, d.day)}</div>
      </div>
      <div class="day-shifts-col">
        <div class="t24-block empty" style="padding:5px 8px;">
          <div class="t24-flow">
            <span class="t24-tag">24H</span>
            <span class="t24-op dash">${outOp || '—'}</span>
            <span class="t24-arrow">→</span>
            <span class="t24-op dash">${d.t24 || '—'}</span>
          </div>
        </div>
        <div class="day-shifts">
          <span class="shift-chip ${!d.t12?'empty':''}">12H ${d.t12?('<b>'+d.t12+'</b>'):'—'}</span>
          <span class="shift-chip ${!d.sitfaa?'empty':''}">SITFAA ${d.sitfaa?('<b>'+d.sitfaa+'</b>'):'—'}</span>
        </div>
      </div>
    </div>`;
  }).join("");

  const swapRows = swaps.length===0 ? `<div class="empty-state">Nenhuma troca efetivada neste mês.</div>` :
    swaps.map(s=>{
      const dt = s.resolvedAt ? new Date(s.resolvedAt).toLocaleDateString('pt-BR') : '';
      const isAssuncao = (s.mode||"troca") === "assuncao";
      const label = isAssuncao
        ? `${s.fromOp} assumiu de ${s.toOp} — dia ${String(s.fromDay).padStart(2,'0')} (${SHIFT_LABEL[s.type]})`
        : `${s.fromOp} dia ${String(s.fromDay).padStart(2,'0')} ⇄ ${s.toOp} dia ${String(s.toDay).padStart(2,'0')} — ${SHIFT_LABEL[s.type]}`;
      return `<div class="req-row swap-jump" data-from="${s.fromDay}" data-to="${s.toDay||''}">
        <div class="req-top">
          <span>${label}</span>
          <span class="status-pill status-accepted">ACEITO</span>
        </div>
        ${dt? `<div class="req-note">Efetivada em ${dt}</div>` : ""}
        <div class="jump-hint">toque para ver na escala ↓</div>
      </div>`;
    }).join("");

  el.innerHTML = `
    <div class="month-select-wrap">
      <label for="histMonthSel">Mês</label>
      <select id="histMonthSel">
        ${state.months.map(mo=>`<option value="${mo}" ${mo===m?'selected':''}>${monthLabel(mo)}</option>`).join("")}
      </select>
    </div>
    <div class="banner">Consulte a escala já lançada de qualquer mês anterior e as trocas que foram efetivamente realizadas (aceitas) naquele mês. Pedidos pendentes ou recusados ficam na aba Trocas.</div>

    <div class="section-title">Trocas efetivadas — ${monthLabel(m)}</div>
    ${swapRows}

    <div class="section-title">Trocas canceladas — ${monthLabel(m)}</div>
    ${cancelledRows}

    <div class="section-title">Escala do mês — ${monthLabel(m)}</div>
    ${dayRows}
  `;

  document.getElementById("histMonthSel").addEventListener("change", async (e)=>{
    await openHistorico(e.target.value);
  });
  el.querySelectorAll(".swap-jump").forEach(row=>{
    row.addEventListener("click", ()=>{
      el.querySelectorAll(".day-row.highlight").forEach(r=>r.classList.remove("highlight"));
      const from = row.dataset.from;
      const to = row.dataset.to;
      [from, to].filter(v=>v).forEach(day=>{
        const target = el.querySelector(`.day-row[data-day="${day}"]`);
        if(target) target.classList.add("highlight");
      });
      const first = el.querySelector(`.day-row[data-day="${from}"]`);
      if(first) first.scrollIntoView({behavior:"smooth", block:"center"});
    });
  });
}

async function openHistorico(monthKey){
  await ensureMonthLoaded(monthKey);
  state.histMonth = monthKey;
  render();
}

/* ======================= RENDER: ESCALANTE ======================= */
function renderEscalante(el){
  if(!state.adminUnlocked){
    el.innerHTML = `
      <div class="lock-screen">
        <h2 class="mono">Área do escalante</h2>
        <p>Digite o código de acesso para montar a escala do próximo mês.</p>
        <label for="adminCode">Código</label>
        <input id="adminCode" type="password" placeholder="••••••••">
        <button class="btn" id="adminSubmit">Entrar</button>
      </div>`;
    document.getElementById("adminSubmit").addEventListener("click", ()=>{
      const val = document.getElementById("adminCode").value;
      if(val === ADMIN_CODE){
        state.adminUnlocked = true;
        openEscalanteMonth(nextMonthKey(state.months[state.months.length-1]));
      } else {
        showToast("Código incorreto");
      }
    });
    return;
  }

  const latest = state.months[state.months.length-1];
  const upcoming = nextMonthKey(latest);
  const hasUpcoming = state.months.includes(upcoming);
  const options = state.months.map(m=>({key:m,label:monthLabel(m)+" — editar"}));
  if(!hasUpcoming) options.push({key:upcoming, label:monthLabel(upcoming)+" — criar novo"});

  const draftMonth = state.escalanteMonth || upcoming;
  const draft = state.escalanteDraft || blankSchedule(draftMonth);

  const dayRows = draft.map(d=>{
    const red = isRedDay(draftMonth, d.day);
    const optionsHtml = (field) => {
      const cur = d[field];
      return `<option value="">—</option>` + OPERATORS.map(o=>`<option value="${o}" ${cur===o?'selected':''}>${o}</option>`).join("");
    };
    return `<div class="builder-row ${red?'red-day':''}">
      <div class="builder-top">Dia ${String(d.day).padStart(2,'0')} <span class="wk ${red?'red':''}">${weekdayOf(draftMonth, d.day)}</span></div>
      <div class="builder-grid">
        <div><label>24H</label><select data-day="${d.day}" data-field="t24">${optionsHtml('t24')}</select></div>
        <div><label>12H</label><select data-day="${d.day}" data-field="t12">${optionsHtml('t12')}</select></div>
        <div><label>SITFAA</label><select data-day="${d.day}" data-field="sitfaa">${optionsHtml('sitfaa')}</select></div>
      </div>
    </div>`;
  }).join("");

  el.innerHTML = `
    <div class="banner">Monte ou edite a escala de um mês. As trocas continuam funcionando normalmente depois que a escala é salva. Sábados, domingos e quartas-feiras aparecem marcados como escala vermelha.</div>

    <div class="card">
      <h3>Importar do Google Sheets</h3>
      <label for="sheetsImportUrl">Link publicado como CSV da planilha do mês</label>
      <input id="sheetsImportUrl" type="text" placeholder="https://docs.google.com/.../pub?output=csv">
      <p style="font-size:11px;color:var(--muted);margin:8px 0 0;">No Sheets: Arquivo → Compartilhar → Publicar na web → formato CSV. A planilha deve ter colunas na ordem DIA, SITFAA, 12H, 24H.</p>
      <button class="btn secondary" id="importSheetsBtn">Importar para o rascunho abaixo</button>
    </div>

    <div class="month-select-wrap">
      <label>Mês em edição</label>
      <select id="escalanteMonthSel">
        ${options.map(o=>`<option value="${o.key}" ${o.key===draftMonth?'selected':''}>${o.label}</option>`).join("")}
      </select>
    </div>
    <div class="section-title">Dias — ${monthLabel(draftMonth)}</div>
    ${dayRows}
    <button class="btn" id="saveEscalante">Salvar escala de ${monthLabel(draftMonth)}</button>

    <div class="card" style="margin-top:20px;">
      <h3>Virada de mês — reenviar ao Sheets</h3>
      <label for="sheetsWebhookUrl">URL do Apps Script (Web App) — configure uma vez</label>
      <input id="sheetsWebhookUrl" type="text" placeholder="https://script.google.com/macros/s/AAAA/exec" value="${state.sheetsWebhook||''}">
      <button class="btn secondary" id="saveWebhookBtn">Salvar URL</button>
      <label for="turnoverMonthSel" style="margin-top:14px;">Mês a encerrar e reenviar</label>
      <select id="turnoverMonthSel">
        ${state.months.map(m=>`<option value="${m}" ${m===state.months[state.months.length-1]?'selected':''}>${monthLabel(m)}</option>`).join("")}
      </select>
      <p style="font-size:11px;color:var(--muted);margin:8px 0 0;">Reenvia a escala final desse mês (já com todas as trocas aplicadas) para o Sheets, no mesmo formato de entrada.</p>
      <button class="btn" id="turnoverBtn">Confirmar virada do mês e reenviar</button>
    </div>

    <button class="btn secondary" id="lockEscalante" style="margin-top:14px;">Sair da área do escalante</button>
  `;

  document.getElementById("importSheetsBtn").addEventListener("click", async ()=>{
    const url = document.getElementById("sheetsImportUrl").value.trim();
    if(!url) return;
    try{
      const res = await fetch(url);
      if(!res.ok) throw new Error("HTTP "+res.status);
      const text = await res.text();
      state.escalanteDraft = parseScheduleCsv(text, draftMonth);
      showToast("Escala importada — revise e toque em Salvar");
      renderEscalante(el);
    }catch(err){
      showToast("Falha ao importar: confira se o link foi publicado como CSV");
    }
  });
  document.getElementById("saveWebhookBtn").addEventListener("click", async ()=>{
    const url = document.getElementById("sheetsWebhookUrl").value.trim();
    state.sheetsWebhook = url;
    try{ await kvSet("config:sheetsWebhook", url); showToast("URL salva"); }
    catch(e){ showToast("Erro ao salvar a URL"); }
  });
  document.getElementById("turnoverBtn").addEventListener("click", async ()=>{
    const webhook = state.sheetsWebhook;
    if(!webhook){ showToast("Configure a URL do Apps Script primeiro"); return; }
    const monthToClose = document.getElementById("turnoverMonthSel").value;
    await ensureMonthLoaded(monthToClose);
    const csv = buildScheduleCsv(state.scheduleCache[monthToClose]);
    const swapsDone = (state.swapsCache[monthToClose]||[]).filter(s=>s.status==="aceito");
    try{
      await fetch(webhook, {
        method: "POST",
        headers: { "Content-Type": "text/plain;charset=utf-8" },
        body: JSON.stringify({ month: monthToClose, csv, swaps: swapsDone })
      });
      showToast("Escala de " + monthLabel(monthToClose) + " reenviada ao Sheets");
    }catch(err){
      showToast("Falha ao reenviar — confira a URL do Apps Script");
    }
  });

  document.getElementById("escalanteMonthSel").addEventListener("change", async (e)=>{
    await openEscalanteMonth(e.target.value);
  });
  document.getElementById("saveEscalante").addEventListener("click", async ()=>{
    const list = state.months.includes(draftMonth) ? state.months : [...state.months, draftMonth].sort();
    await saveSchedule(draftMonth, state.escalanteDraft);
    await saveOriginalSchedule(draftMonth, JSON.parse(JSON.stringify(state.escalanteDraft)));
    if(!state.swapsCache[draftMonth]) { state.swapsCache[draftMonth] = []; await saveSwaps(draftMonth, []); }
    await saveMonthsList(list);
    state.viewMonth = draftMonth;
    state.tab = "escala";
    showToast("Escala de " + monthLabel(draftMonth) + " salva e liberada");
    render();
  });
  document.getElementById("lockEscalante").addEventListener("click", ()=>{
    state.adminUnlocked = false;
    state.escalanteMonth = null;
    state.escalanteDraft = null;
    render();
  });
  el.querySelectorAll("select[data-day]").forEach(sel=>{
    sel.addEventListener("change", ()=>{
      const day = parseInt(sel.dataset.day,10);
      const field = sel.dataset.field;
      const row = state.escalanteDraft.find(d=>d.day===day);
      row[field] = sel.value || null;
    });
  });
}

async function openEscalanteMonth(monthKey){
  await ensureMonthLoaded(monthKey);
  state.escalanteMonth = monthKey;
  state.escalanteDraft = JSON.parse(JSON.stringify(state.scheduleCache[monthKey]));
  render();
}

/* ======================= INIT ======================= */
(async function init(){
  // PWA: injeta ícone real (base64 do brasão) e um manifest gerado em memória, sem precisar de arquivos externos
  document.querySelectorAll('link[rel="apple-touch-icon"], link[rel="icon"]').forEach(l=>{ l.href = LOGO_B64; });
  const manifest = {
    name: "Escala 2SC3 — Sobrevoo",
    short_name: "Escala 2SC3",
    start_url: ".",
    display: "standalone",
    background_color: "#0A1930",
    theme_color: "#0A1930",
    icons: [{ src: LOGO_B64, sizes: "192x192", type: "image/jpeg" }]
  };
  const manifestBlob = new Blob([JSON.stringify(manifest)], {type: "application/manifest+json"});
  document.getElementById("pwaManifest").href = URL.createObjectURL(manifestBlob);

  state.months = await loadMonthsList();
  state.viewMonth = state.months[state.months.length-1];
  await ensureMonthLoaded(state.viewMonth);
  try{ state.sheetsWebhook = await kvGet("config:sheetsWebhook"); }catch(e){ state.sheetsWebhook = null; }
  state.screen = "select";
  render();
})();
</script>
