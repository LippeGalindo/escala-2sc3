  }
  .day-row.mine{border-color:var(--amber);background:#231A08;}
  .day-row.red-day{border-left:4px solid var(--red);}
  .day-num{font-family:'IBM Plex Mono',monospace;font-weight:700;font-size:18px;width:34px;text-align:center;}
  .day-wk{font-size:10px;color:var(--muted);width:34px;text-align:center;margin-top:-2px;}
  .day-wk.red{color:var(--red);font-weight:700;}
  .day-col-date{display:flex;flex-direction:column;align-items:center;flex-shrink:0;}
  .day-shifts-col{display:flex;flex-direction:column;gap:6px;flex:1;min-width:0;}
  .day-shifts{display:flex;gap:6px;flex-wrap:wrap;}
  .shift-chip{
    font-family:'IBM Plex Mono',monospace;font-size:11px;padding:4px 7px;border-radius:6px;
    background:var(--panel-2);border:1px solid var(--border);color:var(--muted);white-space:nowrap;
  }
  .shift-chip b{color:var(--text);}
  .shift-chip.me{border-color:var(--amber);color:var(--amber);}
  .shift-chip.me b{color:var(--amber);}
  .shift-chip.empty{opacity:.45;}
  .t24-block{
    display:flex;flex-direction:column;gap:5px;
    background:var(--panel-2);border:1px solid var(--border);border-radius:7px;
    padding:7px 9px;font-family:'IBM Plex Mono',monospace;font-size:10.5px;
  }
  .t24-block.empty{opacity:.5;}
  .t24-tag{background:var(--border);color:var(--text);padding:2px 5px;border-radius:4px;font-weight:700;flex-shrink:0;font-size:10px;}
  .t24-flow{display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
  .t24-op{font-weight:700;font-size:13px;padding:2px 7px;border-radius:5px;background:var(--panel);border:1px solid var(--border);color:var(--text);flex-shrink:0;}
  .t24-op.dash{color:var(--muted);font-weight:400;}
  .t24-label{color:var(--muted);display:flex;flex-direction:column;line-height:1.15;text-align:center;flex-shrink:0;}
  .t24-label b{color:var(--text);font-size:11px;}
  .t24-label .t24-tiny{font-size:8.5px;letter-spacing:.04em;text-transform:uppercase;}
  .t24-arrow{color:var(--muted);flex-shrink:0;}
  .t24-sub{color:var(--muted);font-size:9.5px;}
  .t24-sub b{color:var(--text);}
  .t24-op.me{background:var(--amber);color:#221900;border-color:var(--amber);}
  .t24-block.me{border-color:var(--amber);}

  /* ---------- Horas ---------- */
  .hours-hero{
    background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);
    padding:20px 14px;text-align:center;margin-bottom:14px;
  }
  .hours-dual{display:flex;align-items:center;justify-content:center;gap:16px;}
  .hours-col{text-align:center;}
  .hours-arrow{color:var(--muted);font-size:18px;flex-shrink:0;}
  .hours-big{font-family:'IBM Plex Mono',monospace;font-size:34px;font-weight:700;color:var(--amber);line-height:1;}
  .hours-label{font-size:11px;color:var(--muted);margin-top:6px;}
  .day-row.highlight{
    outline:2px solid var(--teal);
    animation:histPulse 1.4s ease-in-out 2;
  }
  @keyframes histPulse{
    0%,100%{background:var(--panel);}
    50%{background:#1E3A1C;}
  }
  .swap-jump{cursor:pointer;}
  .swap-jump:active{opacity:.75;}
  .jump-hint{font-size:9.5px;color:var(--muted);margin-top:5px;}
  .breakdown{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-bottom:18px;}
  .bd-card{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:12px 8px;text-align:center;}
  .bd-num{font-family:'IBM Plex Mono',monospace;font-size:20px;font-weight:700;}
  .bd-label{font-size:10px;color:var(--muted);margin-top:3px;}
  .rank-row{display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:var(--panel);border:1px solid var(--border);border-radius:10px;margin-bottom:6px;font-family:'IBM Plex Mono',monospace;font-size:13px;}
  .rank-row.me{border-color:var(--amber);}
  .rank-row span.h{color:var(--muted);}

  /* ---------- Trocas / Escalante ---------- */
  .card{background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);padding:14px;margin-bottom:12px;}
  .card h3{font-family:'IBM Plex Mono',monospace;font-size:13px;margin:0 0 10px;color:var(--text);text-transform:uppercase;letter-spacing:.04em;}
  label{display:block;font-size:11px;color:var(--muted);margin:10px 0 5px;}
  select, input[type=text], input[type=password], .btn{
    width:100%;font-family:'Inter',sans-serif;font-size:14px;padding:10px 10px;
    background:var(--panel-2);border:1px solid var(--border);color:var(--text);border-radius:8px;
  }
  select:focus, input:focus{outline:2px solid var(--amber);outline-offset:1px;}
  .btn{cursor:pointer;font-weight:600;text-align:center;border:1px solid var(--amber);background:var(--amber);color:#221900;margin-top:14px;}
  .btn:hover{filter:brightness(1.06);}
  .btn.secondary{background:none;color:var(--teal);border-color:var(--teal);}
  .btn.decline{background:none;color:var(--red);border-color:var(--red);}
  .btn:disabled{opacity:.4;cursor:not-allowed;}
  .req-row{border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:8px;background:var(--panel-2);}
  .req-top{display:flex;justify-content:space-between;align-items:center;font-family:'IBM Plex Mono',monospace;font-size:12.5px;gap:8px;}
  .req-note{font-size:12px;color:var(--muted);margin-top:6px;}
  .mode-tag{font-size:9px;background:var(--teal);color:#08170a;padding:2px 6px;border-radius:5px;font-weight:700;letter-spacing:.03em;margin-right:4px;}
  .field-warning{font-size:11.5px;color:var(--red);background:#2A1414;border:1px solid var(--red);border-radius:8px;padding:8px 10px;margin-top:8px;line-height:1.4;}
  .status-pill{font-size:10px;padding:3px 8px;border-radius:20px;font-family:'IBM Plex Mono',monospace;letter-spacing:.03em;flex-shrink:0;}
  .status-pending{background:#3A2F0E;color:var(--amber);}
  .status-accepted{background:#0F3323;color:var(--green);}
  .status-declined{background:#3A1414;color:var(--red);}
  .status-cancelled{background:#22293A;color:var(--muted);}
  .req-actions{display:flex;gap:8px;margin-top:10px;}
  .req-actions .btn{margin-top:0;}
  .empty-state{text-align:center;color:var(--muted);font-size:12.5px;padding:24px 10px;border:1px dashed var(--border);border-radius:var(--radius);}
  .banner{font-size:11.5px;color:var(--muted);background:var(--panel-2);border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:16px;line-height:1.5;}
  .toast{position:fixed;bottom:84px;left:50%;transform:translateX(-50%);background:var(--green);color:#0A2416;font-weight:600;font-size:13px;padding:9px 16px;border-radius:20px;z-index:30;opacity:0;pointer-events:none;transition:opacity .2s, transform .2s;}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(-4px);}

  /* ---------- Escalante builder ---------- */
  .builder-row{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:7px;}
  .builder-row.red-day{border-left:4px solid var(--red);}
  .builder-top{display:flex;align-items:baseline;gap:8px;margin-bottom:8px;font-family:'IBM Plex Mono',monospace;font-size:13px;font-weight:700;}
  .builder-top .wk{font-size:10px;color:var(--muted);font-weight:400;}
  .builder-top .wk.red{color:var(--red);font-weight:700;}
  .builder-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;}
  .builder-grid label{margin:0 0 4px;font-size:9.5px;}
  .builder-grid select{padding:7px 6px;font-size:12px;}
  .lock-screen{padding:40px 20px;}
  .lock-screen h2{font-family:'IBM Plex Mono',monospace;text-align:center;font-size:18px;}
  .lock-screen p{text-align:center;color:var(--muted);font-size:12.5px;}
  ::selection{background:var(--amber);color:#221900;}
  @media (prefers-reduced-motion: reduce){ *{transition:none !important;} }
</style>
