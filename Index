<style>
  :root{
    --bg:#0A1930;
    --panel:#11253F;
    --panel-2:#183050;
    --border:#254269;
    --text:#EEF3F8;
    --muted:#87A2C2;
    --amber:#EDBB3E;
    --teal:#4F8B3E;
    --red:#D6483F;
    --green:#5FBF8A;
    --radius:12px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;}
  body{padding-bottom:76px;min-height:100vh;}
  .mono{font-family:'IBM Plex Mono',monospace;}
  #app{max-width:520px;margin:0 auto;min-height:100vh;position:relative;}

  /* ---------- Header ---------- */
  header.top{
    padding:18px 16px 14px;
    border-bottom:1px solid var(--border);
    background:linear-gradient(180deg, #0E2038 0%, #0A1930 100%);
    position:sticky; top:0; z-index:10;
  }
  .eyebrow{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;color:var(--teal);text-transform:uppercase;}
  .org{font-size:12px;color:var(--muted);margin-top:2px;}
  .title-row{display:flex;align-items:center;justify-content:space-between;margin-top:8px;}
  .header-brand{display:flex;align-items:center;gap:10px;min-width:0;}
  .logo-img{width:38px;height:38px;border-radius:50%;object-fit:cover;border:1px solid var(--border);flex-shrink:0;background:#fff;}
  h1{font-family:'IBM Plex Mono',monospace;font-size:19px;margin:0;letter-spacing:.02em;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .op-badge{display:flex;align-items:center;gap:8px;flex-shrink:0;}
  .op-chip{font-family:'IBM Plex Mono',monospace;font-weight:700;font-size:13px;background:var(--amber);color:#221900;padding:5px 10px;border-radius:8px;letter-spacing:.05em;}
  .swap-user{font-size:11px;color:var(--muted);background:none;border:1px solid var(--border);padding:5px 8px;border-radius:8px;cursor:pointer;}
  .swap-user:hover{border-color:var(--muted);}

  /* ---------- Select Operator Screen ---------- */
  .select-screen{padding:36px 20px;}
  .select-screen .logo-hero{display:block;margin:0 auto 14px;width:88px;height:88px;border-radius:50%;object-fit:cover;border:2px solid var(--border);background:#fff;}
  .select-screen .eyebrow{display:block;text-align:center;margin-bottom:6px;}
  .select-screen h2{font-family:'IBM Plex Mono',monospace;text-align:center;font-size:20px;margin:0 0 4px;}
  .select-screen p.sub{text-align:center;color:var(--muted);font-size:13px;margin:0 0 28px;}
  .op-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
  .op-btn{
    font-family:'IBM Plex Mono',monospace;font-weight:700;font-size:16px;
    background:var(--panel);border:1px solid var(--border);color:var(--text);
    padding:18px 0;border-radius:var(--radius);cursor:pointer;letter-spacing:.05em;
    transition:border-color .15s, background .15s;
  }
  .op-btn:hover, .op-btn:focus-visible{border-color:var(--amber);background:var(--panel-2);outline:none;}

  /* ---------- Tabs ---------- */
  nav.tabs{
    position:fixed;bottom:0;left:0;right:0;z-index:20;
    background:#0D1D33;border-top:1px solid var(--border);
    display:flex;max-width:520px;margin:0 auto;
  }
  nav.tabs button{
    flex:1;background:none;border:none;color:var(--muted);padding:11px 2px 9px;
    font-family:'Inter',sans-serif;font-size:9.3px;letter-spacing:.01em;cursor:pointer;
    display:flex;flex-direction:column;align-items:center;gap:4px;white-space:nowrap;
  }
  nav.tabs button .dot{width:5px;height:5px;border-radius:50%;background:transparent;}
  nav.tabs button.active{color:var(--text);}
  nav.tabs button.active .dot{background:var(--amber);}

  main{padding:16px 16px 8px;}
  .section-title{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:18px 0 10px;}
  .section-title:first-child{margin-top:0;}
  .month-hint{font-size:11px;color:var(--muted);margin:-6px 0 14px;}

  /* ---------- Month selector ---------- */
  .month-select-wrap label{margin-top:0;}
  .month-select-wrap select{width:100%;}

  /* ---------- Escala list ---------- */
  .day-row{
    display:flex;align-items:center;gap:12px;
    background:var(--panel);border:1px solid var(--border);border-radius:var(--radius);
